rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'nikhilprajapathi1@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.role in ['ADMIN', 'USER'] &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             (!('createdAt' in data) || data.createdAt is string);
    }

    function isValidSystemState(data) {
      return data.keys().hasAll(['killSwitch']) &&
             data.keys().hasOnly(['killSwitch', 'autonomousLoopActive', 'lastHourlyTriggerAt', 'updatedBy', 'updatedAt']) &&
             data.killSwitch is bool &&
             (!('autonomousLoopActive' in data) || data.autonomousLoopActive is bool) &&
             (!('lastHourlyTriggerAt' in data) || data.lastHourlyTriggerAt is string) &&
             (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128)) &&
             (!('updatedAt' in data) || data.updatedAt is string);
    }

    function isValidPendingUpdate(data) {
      return data.keys().hasAll(['id', 'title', 'targetFile', 'diff', 'status']) &&
             data.keys().hasOnly(['id', 'title', 'targetFile', 'branch', 'summary', 'diff', 'status', 'passRate', 'totalTests', 'createdAt', 'reviewedBy', 'reviewedAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 256 &&
             data.targetFile is string && data.targetFile.size() <= 256 &&
             data.diff is string && data.diff.size() <= 65536 &&
             data.status in ['PENDING', 'APPROVED', 'REJECTED'] &&
             (!('branch' in data) || (data.branch is string && data.branch.size() <= 128)) &&
             (!('summary' in data) || (data.summary is string && data.summary.size() <= 2048)) &&
             (!('passRate' in data) || data.passRate is number) &&
             (!('totalTests' in data) || data.totalTests is number) &&
             (!('createdAt' in data) || data.createdAt is string) &&
             (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 128)) &&
             (!('reviewedAt' in data) || data.reviewedAt is string);
    }

    function isValidTelemetryLog(data) {
      return data.keys().hasAll(['id', 'timestamp', 'level', 'message']) &&
             data.keys().hasOnly(['id', 'timestamp', 'level', 'source', 'message', 'tokensUsed']) &&
             data.id is string && data.id.size() <= 128 &&
             data.timestamp is string &&
             data.level in ['INFO', 'WARN', 'ERROR'] &&
             data.message is string && data.message.size() <= 4096 &&
             (!('source' in data) || (data.source is string && data.source.size() <= 128)) &&
             (!('tokensUsed' in data) || data.tokensUsed is number);
    }

    match /test/{docId} {
      allow read: if true;
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId);
      allow list: if isAdmin();
      allow write: if isAdmin() && isValidId(adminId);
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUser(incoming()) && (incoming().role == 'USER' || isAdmin());
      allow update: if isSignedIn() && isValidId(userId) && (
        (request.auth.uid == userId && isValidUser(incoming()) && incoming().role == existing().role) ||
        (isAdmin() && isValidUser(incoming()))
      );
      allow delete: if isAdmin() && isValidId(userId);
    }

    match /system_state/{stateId} {
      allow get, list: if isSignedIn() && isValidId(stateId);
      allow write: if isAdmin() && isValidId(stateId) && isValidSystemState(incoming());
    }

    match /pending_updates/{updateId} {
      allow get, list: if isSignedIn() && isValidId(updateId);
      allow write: if isAdmin() && isValidId(updateId) && isValidPendingUpdate(incoming());
    }

    match /telemetry_logs/{logId} {
      allow get, list: if isSignedIn() && isValidId(logId);
      allow write: if isAdmin() && isValidId(logId) && isValidTelemetryLog(incoming());
    }
  }
}
